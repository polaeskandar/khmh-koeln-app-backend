{
    "name": "khmk-koeln/backend",
    "description": "KHMK Köln API (Symfony). Initialized only; features are added through tickets.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "nelmio/cors-bundle": "^2.6",
        "nesbot/carbon": "^3.15",
        "phpdocumentor/type-resolver": "^2.1",
        "phpstan/phpdoc-parser": "^2.4",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mailgun-mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "captainhook/hook-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Tools\\": "tools/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": [
            "@test:prepare @no_additional_args",
            "@php bin/console app:migrations:check --env=test @no_additional_args",
            "@php bin/phpunit"
        ],
        "lint": [
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config --parse-tags",
            "@php bin/console doctrine:schema:validate --skip-sync"
        ],
        "format": [
            "mago format",
            "mago lint --fix",
            "phpcbf --standard=tools/CodingStandard/ruleset.xml || [ $? -eq 1 ]",
            "mago format"
        ],
        "check": [
            "mago format --check",
            "mago lint",
            "mago analyze",
            "mago guard",
            "phpinsights analyse --no-interaction",
            "phpcs --standard=tools/CodingStandard/ruleset.xml",
            "@lint",
            "@test"
        ],
        "db:test:reset": [
            "@php bin/console doctrine:database:drop --env=test --force --if-exists --quiet",
            "@php bin/console doctrine:database:create --env=test --quiet",
            "@php bin/console app:migrations:migrate --env=test --no-interaction --quiet"
        ],
        "ci": [
            "@composer validate --strict",
            "@composer audit",
            "@db:test:reset",
            "@check"
        ],
        "test:prepare": [
            "@php bin/console cache:clear --env=test --no-debug --quiet",
            "@php bin/console doctrine:database:create --env=test --if-not-exists --quiet",
            "@php bin/console app:migrations:migrate --env=test --no-interaction --quiet"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*",
            "docker": false
        },
        "captainhook": {
            "only-enabled": true,
            "force-install": true
        }
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "captainhook/hook-installer": "^1.0",
        "carthage-software/mago": "^1.59",
        "dama/doctrine-test-bundle": "^8.7",
        "nunomaduro/phpinsights": "^2.15",
        "phpunit/phpunit": "^13.4.5",
        "ramsey/conventional-commits": "^1.7",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/finder": "8.1.*",
        "symfony/maker-bundle": "^1.68"
    }
}
