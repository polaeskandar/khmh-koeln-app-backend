{
	admin off
	auto_https off
	frankenphp
}

{$SERVER_NAME} {
	root * /app/public
	encode zstd gzip

	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}

	php_server
}
