###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://khmk:khmk@127.0.0.1:5436/khmk?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###
SESSION_LIFETIME=2592000

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN=
MOBILE_APP_ORIGINS=capacitor://localhost,https://localhost
###< nelmio/cors-bundle ###
API_TOKEN_LIFETIME=P90D
FRONTEND_URL=https://app.khmk-koeln.com
TRUSTED_PROXIES=
TRUSTED_HOSTS='^(app\.khmk-koeln\.com|localhost|127\.0\.0\.1)$'

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###
