{
    "config": {
        "run": {
            "mode": "docker",
            "exec": "docker compose run --rm -T api",
            "path": "vendor/bin/captainhook"
        }
    },
    "commit-msg": {
        "enabled": true,
        "actions": [
            {"action": "\\Ramsey\\CaptainHook\\ValidateConventionalCommit"}
        ]
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {"action": "composer check"}
        ]
    }
}
