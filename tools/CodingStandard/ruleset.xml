<?xml version="1.0"?>
<ruleset name="CodingStandard">
    <description>Blank lines that set blocks apart (docs/code-style.md).</description>

    <file>../../src</file>
    <file>../../tests</file>
    <file>../../tools</file>
    <exclude-pattern>*/Infrastructure/Persistence/Migrations/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="cache" value="../../var/cache/phpcs.cache"/>

    <rule ref="../../vendor/slevomat/coding-standard/SlevomatCodingStandard/Sniffs/ControlStructures/BlockControlStructureSpacingSniff.php"/>
    <rule ref="../../vendor/slevomat/coding-standard/SlevomatCodingStandard/Sniffs/ControlStructures/JumpStatementsSpacingSniff.php"/>
    <rule ref="./Sniffs/Spacing/MultiLineStatementSpacingSniff.php"/>
</ruleset>
